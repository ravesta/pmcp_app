{
  "name": "pmcp",
  "version": "0.1.0",
  "private": true,
  "description": "PMCP: Project Monitoring & Capacity Planning System (tim BA dan QA)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "perf:seed": "node scripts/seed-reference-data.mjs",
    "perf:measure": "node scripts/measure-performance.mjs",
    "sessions:cleanup": "node scripts/cleanup-sessions.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dry": "node scripts/migrate.mjs --dry-run",
    "db:pull": "prisma db pull && prisma generate",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/pg": "^8.23.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
